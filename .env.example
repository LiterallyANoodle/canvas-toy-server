# Dragon Mail settings (all optional except DB_PASSWORD). In the compose, these go in .env.
DB_HOST=postgres
DB_NAME=dragonmail
DB_USER=dragonmail
DB_PASSWORD=
DISCORD_WEBHOOK_URL=
# Limits (defaults shown)
MAX_WIDTH=500
MAX_HEIGHT=500
MAX_BODY_BYTES=2000000
RATE_PERIOD_S=3600
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_PER_IP=10
CLIENT_IP_HEADER=CF-Connecting-IP
