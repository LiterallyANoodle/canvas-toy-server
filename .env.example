# Dragon Mail settings (all optional except DB_PASSWORD). In the compose, these go in .env.
DB_HOST=postgres
DB_NAME=dragonmail
DB_USER=dragonmail
DB_PASSWORD=
DISCORD_WEBHOOK_URL=
# Limits (defaults shown)
MAX_WIDTH=500
MAX_HEIGHT=500
MAX_BODY_BYTES=2000000
RATE_PERIOD_S=3600
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_PER_IP=10
CLIENT_IP_HEADER=CF-Connecting-IP
REQUIRE_CLIENT_IP_HEADER=1
# Comments (defaults shown)
COMMENT_MAX_CHARS=500
COMMENT_RATE_PERIOD_S=600
COMMENT_RATE_LIMIT_GLOBAL=60
COMMENT_RATE_LIMIT_PER_IP=5
# The public address, for the gallery link in Discord messages
PUBLIC_BASE_URL=https://canvas.noodledragon.fans
# /admin: off unless both are set. The team domain is <team>.cloudflareaccess.com; the AUD is
# the "Application Audience (AUD) Tag" on the Access application's overview page.
CF_ACCESS_TEAM_DOMAIN=noodledragon.cloudflareaccess.com
CF_ACCESS_AUD=
# Optional: only these emails may use /admin (comma-separated). Empty = whoever Access lets in.
ADMIN_EMAILS=
